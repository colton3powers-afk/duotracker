PORT=3000
# Required: comma-separated Apple US part numbers, e.g. ABC12LL/A,XYZ34LL/A
# Find these using Apple.com pickup check > browser DevTools > Network > pickup-message > parts.0
DUO_PARTS=
# Optional labels in same order, e.g. 256GB Night Sky,256GB Star White
DUO_LABELS=
# 60s minimum server-side cache (increase for nationwide monitoring)
CACHE_SECONDS=120
# Comma-separated additional US ZIP codes to expand nationwide coverage
EXTRA_ZIPS=
# iPhone 18 Pro Max Apple part numbers, matching labels below
PRO_MAX_PARTS=
PRO_MAX_LABELS=
